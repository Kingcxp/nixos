{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "#363a4f",
          "foreground": "#cad3f5",
          "leading_diamond": "\ue0b2",
          "options": {
            "macos": "\uf179 ",
            "ubuntu": "\uf31b ",
            "windows": "\ue62a "
          },
          "style": "diamond",
          "template": "{{ .Icon }}",
          "trailing_diamond": "<transparent,#363a4f>\ue0b2</>",
          "type": "os"
        },
        {
          "background": "#494d64",
          "foreground": "#cad3f5",
          "leading_diamond": "\ue0b2",
          "options": {
            "folder_icon": "\uf07b ",
            "folder_separator_icon": " \uf061 ",
            "home_icon": "\ueb06 ",
            "style": "full"
          },
          "style": "diamond",
          "template": " {{ .Path }} ",
          "trailing_diamond": "<transparent,#494d64>\ue0b2</>",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#8bd5ca",
          "foreground": "#181926",
          "leading_diamond": "\ue0b2",
          "options": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "diamond",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "\ue0b0",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "style": "plain",
          "template": "\u256d\u2500",
          "type": "text"
        },
        {
          "options": {
            "time_format": "15:04"
          },
          "style": "plain",
          "template": " \u2665 {{ .CurrentDate | date .Format }} |",
          "type": "time"
        },
        {
          "style": "plain",
          "template": " \ue289 {{ .FormattedMs }} |",
          "type": "executiontime"
        },
        {
          "foreground": "#8aadf4",
          "style": "plain",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}py{{ end }}",
          "type": "python"
        },
        {
          "foreground": "#a6da95",
          "style": "plain",
          "template": " \ue718 {{ if .Error }}{{ .Error }}{{ else }}node{{ end }}",
          "type": "node"
        },
        {
          "foreground": "#91d7e3",
          "style": "plain",
          "template": " \ue626 {{ if .Error }}{{ .Error }}{{ else }}go{{ end }}",
          "type": "go"
        },
        {
          "foreground": "#f5a97f",
          "style": "plain",
          "template": " \ue7a8 {{ if .Error }}{{ .Error }}{{ else }}rs{{ end }}",
          "type": "rust"
        },
        {
          "style": "plain",
          "template": " \uf292 ",
          "type": "root"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "style": "plain",
          "template": "\u2570\u2500 ",
          "type": "text"
        },
        {
          "always_enabled": true,
          "style": "plain",
          "template": "{{ if eq .Code 0 }}<#a6da95>\uf058</>{{ else }}<#ed8796>\uf071 {{ .Code }}</>{{ end }}",
          "type": "exit"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{ .Folder }}",
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#cad3f5",
    "template": "\ue285 "
  },
  "version": 4
}
